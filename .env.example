# ==============================================================================
# TIMELESS TRENDS — Environment Variables Configuration Template
# Copy this file to .env and configure the appropriate values.
# NEVER commit .env with real secrets to version control.
# ==============================================================================

# Server & Runtime Configuration
PORT=4000
NODE_ENV=development
BUSINESS_TZ=Asia/Kolkata

# Database (Supabase PostgreSQL Connection)
# Obtain this URI from your Supabase Dashboard -> Project Settings -> Database -> Connection string (NodeJS / URI)
DATABASE_URL=postgres://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase Client API Keys (Optional, for client SDK / Storage)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-publishable-key
# NOTE: Never expose SUPABASE_SERVICE_ROLE_KEY in frontend / client-side code!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage / Uploads Directory
UPLOAD_DIR=./uploads

# Business WhatsApp Configuration
# International format without + or spaces (e.g. 918014445111 for India +91 8014445111)
WHATSAPP_NUMBER=918014445111

# Public Deployment URL (Set in production, e.g. https://timelesstrends.in)
PUBLIC_URL=

# Email / SMTP Configuration (For Admin OTP Login)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-specific-password

# Admin OTP Security Settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
