# Copy to .env and edit. Never commit .env.
PORT=4000
NODE_ENV=development
# Digits only, with country code, e.g. 919876543210 (leave blank until you have the real number)
WHATSAPP_NUMBER=
# Public website address, used in WhatsApp messages (e.g. https://timelesstrends.example). Blank = no link in message.
PUBLIC_URL=
BUSINESS_TZ=Asia/Kolkata
